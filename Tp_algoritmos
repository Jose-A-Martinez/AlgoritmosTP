# Función Valida Acceso
def ValidaAcceso(usuario, contra, arreglo):
    i = 0
    while i < 10:
        if usuario == arreglo[i][0] and contra == arreglo[i][1]:
            pos = i
            i = 10
        else:
            pos = -1
            i = i + 1
    if pos == -1:
        limpiarPantalla()
        print("Usuario y/o contraseña incorrectos")
    return pos

