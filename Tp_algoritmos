# Procedimiento para busqueda dicotomica
def buscarDicotomica(ARREGLO, COD):
    inf = 0
    sup = contarRegistros(ARREGLO)-1
    med = (sup+inf)//2
    while inf <= sup and (ARREGLO[med][0].lower() != COD.lower()):
        if ARREGLO[med][0].lower() > COD.lower():
            sup = med-1
        else:
            inf = med+1
        med = (sup+inf)//2
    if ARREGLO[med][0].lower() == COD.lower():
        return True
    else:
        return False

# Procedimiento para buscqueda secuencial dinamico para cuaquier arreglo
def buscarSecuencial(ARREGLO,COD):
    cont = contarRegistros(ARREGLO)# 100 es el maximo de registros definidos en los arreglos del TP
    inicio = 0
    while inicio < cont: 
        if ARREGLO[inicio][0] == COD:
            inicio = cont # si se encuentra el codigo, se sale del while
            return True
        inicio = inicio + 1
    return False

